# =========================================================
# ShadowTopUp Production Environment Configuration
# =========================================================

# 1. Supabase (Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. UCBot Garena Topup Automation API
# Gateway: https://ffapi.ucbot.net/topup-sync
UC_BOT_EMAIL=your-ucbot-registered-email@gmail.com
UC_BOT_API_KEY=your-ucbot-api-token-uuid
GARENA_SHELL_AUTOCODE=your-garena-authenticator-secret-code

# 3. Dialog eZ Cash Automated Verification Gateway
# Gateway: https://ffapi.ucbot.net/verify
EZCASH_API_TOKEN=your-ezcash-api-token-uuid
NEXT_PUBLIC_EZCASH_NUMBER=0765604635
NEXT_PUBLIC_EZCASH_NAME=Shadow Store
NEXT_PUBLIC_CONTACT_NUMBER=0765604635

# 4. Free Fire Player Verification API
# Supports single key or comma-separated rotation pool (key1,key2)
HL_GAMING_USERUID=your-hl-gaming-user-uid
HL_GAMING_API_KEY=your-hl-gaming-api-key

# 5. PayPal Checkout (Optional / Alternative)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox

# 6. Public Application Domain
NEXT_PUBLIC_APP_URL=https://shadowtopup.com
