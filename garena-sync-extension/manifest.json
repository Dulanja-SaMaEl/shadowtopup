{
  "manifest_version": 3,
  "name": "Shadow Store - Garena Shell Sync",
  "version": "1.0.0",
  "description": "1-Click automated live Shell stock sync for Shadow Store",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync Garena Shells to Shadow Store"
  },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://shop.garena.my/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://shop.garena.my/*",
    "https://vdqyxwenhzhucmqiyogi.supabase.co/*"
  ]
}
