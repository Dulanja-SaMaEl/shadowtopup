    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const uidInput = document.getElementById('game_uid');
            const verifyBtn = document.getElementById('verify_uid');
            const resultDiv = document.getElementById('verification_result');
            const nicknameText = document.getElementById('player_nickname');
            const productUidInputs = document.querySelectorAll('.product-game-uid');
            const cartForms = document.querySelectorAll('.cart-form');

            verifyBtn.addEventListener('click', function() {
                const uid = uidInput.value.trim();
                if (!uid) {
                    alert('Please enter your Player ID first!');
                    return;
                }

                verifyBtn.innerHTML = '...';
                verifyBtn.disabled = true;

                // Mock API Call
                setTimeout(() => {
                    nicknameText.innerText = 'Player_' + uid;
                    resultDiv.classList.remove('hidden');
                    verifyBtn.innerHTML = 'Verify';
                    verifyBtn.disabled = false;
                    
                    // Update hidden inputs in product forms
                    productUidInputs.forEach(input => {
                        input.value = uid;
                    });
                }, 800);
            });

            // Prevent form submission if UID is not set
            cartForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    const uidInputInForm = this.querySelector('.product-game-uid');
                    if (!uidInputInForm.value || uidInputInForm.value.trim() === '') {
                        e.preventDefault();
                        alert('Please enter and verify your Player ID before adding to cart!');
                        uidInput.focus();
                    }
                });
            });

            // Update hidden inputs on change too
            uidInput.addEventListener('input', function() {
                productUidInputs.forEach(input => {
                    input.value = uidInput.value.trim();
                });
            });
        });
    </script>
</x-store-layout>
