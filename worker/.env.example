# ShadowTopUp Local Worker — Environment Variables
# Copy this file to .env and fill in your real values

# ─── Supabase (copy from your Vercel/frontend .env) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Garena Shell Account Credentials ─────────────────────────────────────────
GARENA_USERNAME=SHADOW_TOPUP1
GARENA_PASSWORD=Shadow-2008

# ─── Worker Settings ──────────────────────────────────────────────────────────
# Set to 'false' to watch the browser window during automation (recommended for first run)
HEADLESS=false
